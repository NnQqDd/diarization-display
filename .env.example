# The diarization-annotate checkout whose dataset this app opens. Everything
# else is derived from it, so this is usually the only line you need.
ANNOTATEPATH=/home/duyn/ActableDuy/diarization-annotate

# Set this only when the data does not live inside that checkout.
# DATASET_DIR=/srv/diarization/dataset

# PORT=8200
# HOST=127.0.0.1
# MAX_UPLOAD_MB=1024

# Who may edit, and who is refused the page. Two CSVs of client_id,user_name;
# by default they sit beside this file. See app/access.py.
# WHITELIST_CSV=/etc/diarization/whitelist.csv
# BLACKLIST_CSV=/etc/diarization/blacklist.csv
